function card(m, big) {
  const badge = big ? `<span class="badge-mat">matlådor</span>` : m.ny ? `<span class="badge-ny">nytt</span>` : '';
  return `<div class="meal-card ${big ? 'big' : m.ny ? 'ny-kort' : ''}" onclick="openModal('${m.n.replace(/'/g,"\\'")}','${m.i}','${big?'Stor sats':'Kvällsrätt'}')">
    <div class="card-top">
      <div>
        <div class="card-meta">${big ? 'Stor sats' : 'Kvällsrätt'}</div>
        <div class="card-name">${m.n}</div>
      </div>
      <div style="display:flex;flex-direction:column;align-items:flex-end;gap:6px">
        <span class="card-icon">${m.i}</span>
        ${badge}
      </div>
    </div>
    <p class="card-desc">${m.d}</p>
    <div class="tags">${m.t.map(t => `<span class="tag ${tagClass[t]||''}">${t}</span>`).join('')}</div>
    <p class="card-hint">↗ Visa recept & ingredienser</p>
  </div>`;
}

