// Modal logic
let baseServings = 4;
let currentServings = 4;
let currentRecipe = null;

function openModal(name, icon, meta) {
  const r = recipes[name];
  if (!r) return;
  currentRecipe = r;
  baseServings = r.servings;
  currentServings = r.servings;
  document.getElementById('m-icon').textContent = icon;
  document.getElementById('m-title').textContent = name;
  document.getElementById('m-meta').textContent = meta;
  document.getElementById('srv-count').textContent = currentServings;
  renderIngredients();
  renderSteps(r.steps);
  document.getElementById('overlay').classList.add('open');
  document.body.style.overflow = 'hidden';
}

function renderIngredients() {
  const ul = document.getElementById('m-ingredients');
  ul.innerHTML = currentRecipe.ingredients.map(([name, qty]) => {
    if (qty === '') return `<li style="border-bottom:none;margin-top:8px"><span style="font-size:11px;letter-spacing:0.08em;text-transform:uppercase;color:var(--muted)">${name}</span></li>`;
    const scaled = scaleQty(qty, baseServings, currentServings);
    return `<li><span class="ing-name">${name}</span><span class="ing-qty">${scaled}</span></li>`;
  }).join('');
}

function scaleQty(qty, base, target) {
  if (base === target) return qty;
  const factor = target / base;
  return qty.replace(/(\d+[,.]?\d*)/g, (m) => {
    const n = parseFloat(m.replace(',','.')) * factor;
    const r = Math.round(n * 4) / 4;
    return r === Math.floor(r) ? r.toString() : r.toFixed(1).replace('.',',');
  });
}

function renderSteps(steps) {
  const ol = document.getElementById('m-steps');
  ol.innerHTML = steps.map((s, i) => `<li><span class="step-num">${i+1}</span><span>${s}</span></li>`).join('');
}

function closeModal() {
  document.getElementById('overlay').classList.remove('open');
  document.body.style.overflow = '';
}

document.getElementById('modal-close').onclick = closeModal;
document.getElementById('overlay').onclick = (e) => { if (e.target === document.getElementById('overlay')) closeModal(); };
document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });

document.getElementById('srv-up').onclick = () => {
  currentServings++;
  document.getElementById('srv-count').textContent = currentServings;
  renderIngredients();
};
document.getElementById('srv-down').onclick = () => {
  if (currentServings > 1) { currentServings--; document.getElementById('srv-count').textContent = currentServings; renderIngredients(); }
};
