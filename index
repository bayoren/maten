<!DOCTYPE html>
<html lang="sv">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Matplanering — 5 veckor</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --cream: #F7F4EF;
    --ink: #1C1917;
    --muted: #6B6560;
    --green: #2D6A4F;
    --green-light: #D8F3DC;
    --blue: #1D5A8A;
    --blue-light: #DBE9F4;
    --amber: #92400E;
    --amber-light: #FEF3C7;
    --purple: #4C3A8B;
    --purple-light: #EDE9FE;
    --red: #9B2335;
    --red-light: #FDE8EB;
    --border: rgba(28,25,23,0.1);
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  body { background: var(--cream); color: var(--ink); font-family: 'DM Sans', sans-serif; font-weight: 300; min-height: 100vh; }

  header {
    background: var(--ink); color: var(--cream);
    padding: 2.5rem 2rem 2rem; position: relative; overflow: hidden;
  }
  header::before { content:''; position:absolute; top:-40px; right:-40px; width:220px; height:220px; border-radius:50%; background:rgba(181,84,26,0.15); }
  header::after  { content:''; position:absolute; bottom:-60px; left:30%; width:160px; height:160px; border-radius:50%; background:rgba(45,106,79,0.12); }
  .header-inner { max-width: 800px; margin: 0 auto; position: relative; z-index: 1; }
  header h1 { font-family:'Playfair Display',serif; font-size:clamp(2rem,5vw,3rem); font-weight:600; letter-spacing:-0.02em; line-height:1.15; margin-bottom:0.5rem; }
  header p { color:rgba(247,244,239,0.6); font-size:0.9rem; letter-spacing:0.04em; text-transform:uppercase; }
  .legend { display:flex; flex-wrap:wrap; gap:8px; margin-top:1.25rem; }
  .legend-item { display:flex; align-items:center; gap:5px; font-size:11px; color:rgba(247,244,239,0.7); letter-spacing:0.03em; }
  .legend-dot { width:8px; height:8px; border-radius:2px; }

  main { max-width: 800px; margin: 0 auto; padding: 2rem 1.25rem 4rem; }

  .week-nav {
    display:flex; gap:6px; flex-wrap:wrap; margin-bottom:2rem;
    position:sticky; top:0; z-index:10; background:var(--cream);
    padding:0.75rem 0; border-bottom:1px solid var(--border);
  }
  .week-btn {
    padding:6px 16px; border-radius:99px; border:1px solid var(--border);
    background:transparent; cursor:pointer; font-family:'DM Sans',sans-serif;
    font-size:13px; font-weight:400; color:var(--muted); transition:all 0.18s;
  }
  .week-btn:hover { border-color:var(--ink); color:var(--ink); }
  .week-btn.active { background:var(--ink); color:var(--cream); border-color:var(--ink); }

  .week-panel { display:none; animation:fadeIn 0.2s ease; }
  .week-panel.active { display:block; }
  @keyframes fadeIn { from { opacity:0; transform:translateY(4px); } to { opacity:1; transform:translateY(0); } }

  .section-heading {
    font-size:10px; letter-spacing:0.12em; text-transform:uppercase;
    color:var(--muted); margin:0 0 0.75rem;
    display:flex; align-items:center; gap:8px;
  }
  .section-heading::after { content:''; flex:1; height:1px; background:var(--border); }
  .section-block { margin-bottom: 2rem; }
  .meal-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(300px,1fr)); gap:10px; }

  .meal-card {
    background:white; border:1px solid var(--border); border-radius:12px;
    padding:1.1rem 1.25rem; cursor:pointer;
    transition:box-shadow 0.15s, transform 0.15s;
  }
  .meal-card:hover { box-shadow:0 6px 24px rgba(28,25,23,0.1); transform:translateY(-1px); }
  .meal-card.big { border-top:3px solid var(--green); }
  .meal-card.ny-kort { border-top:3px solid var(--purple); }

  .card-top { display:flex; align-items:flex-start; justify-content:space-between; margin-bottom:6px; }
  .card-meta { font-size:10px; letter-spacing:0.08em; text-transform:uppercase; color:var(--muted); margin-bottom:4px; }
  .card-name { font-family:'Playfair Display',serif; font-size:1.05rem; font-weight:400; line-height:1.35; margin-bottom:6px; }
  .card-desc { font-size:13px; color:var(--muted); line-height:1.6; margin-bottom:10px; }
  .card-icon { font-size:22px; line-height:1; }
  .card-hint { font-size:11px; color:var(--muted); margin-top:8px; display:flex; align-items:center; gap:4px; opacity:0.7; }

  .tags { display:flex; flex-wrap:wrap; gap:4px; }
  .tag { font-size:10px; padding:2px 8px; border-radius:99px; letter-spacing:0.03em; font-weight:500; }
  .tag-grön { background:var(--green-light); color:var(--green); }
  .tag-fisk { background:var(--blue-light); color:var(--blue); }
  .tag-kött { background:var(--red-light); color:var(--red); }
  .tag-matlåda { background:#D1FAE5; color:#065F46; }
  .tag-potatis { background:var(--amber-light); color:var(--amber); }
  .tag-baljväxter { background:var(--purple-light); color:var(--purple); }
  .tag-nytt { background:var(--purple-light); color:var(--purple); font-style:italic; }

  .badge-ny { font-size:9px; background:var(--purple-light); color:var(--purple); border-radius:99px; padding:2px 8px; font-weight:500; letter-spacing:0.04em; white-space:nowrap; }
  .badge-mat { font-size:9px; background:var(--green-light); color:var(--green); border-radius:99px; padding:2px 8px; font-weight:500; letter-spacing:0.04em; white-space:nowrap; }

  /* Modal */
  .modal-overlay {
    display:none; position:fixed; inset:0; z-index:100;
    background:rgba(28,25,23,0.55); backdrop-filter:blur(3px);
    align-items:center; justify-content:center; padding:1rem;
  }
  .modal-overlay.open { display:flex; animation:fadeOverlay 0.2s ease; }
  @keyframes fadeOverlay { from { opacity:0; } to { opacity:1; } }

  .modal {
    background:var(--cream); border-radius:16px; width:100%; max-width:560px;
    max-height:88vh; overflow-y:auto; position:relative;
    animation:slideUp 0.22s ease;
  }
  @keyframes slideUp { from { opacity:0; transform:translateY(16px); } to { opacity:1; transform:translateY(0); } }

  .modal-header {
    background:var(--ink); color:var(--cream);
    padding:1.5rem 1.5rem 1.25rem; border-radius:16px 16px 0 0;
    position:relative;
  }
  .modal-header .m-icon { font-size:2rem; margin-bottom:0.5rem; display:block; }
  .modal-header h2 { font-family:'Playfair Display',serif; font-size:1.3rem; font-weight:400; line-height:1.3; }
  .modal-header p { font-size:12px; color:rgba(247,244,239,0.55); margin-top:4px; letter-spacing:0.04em; text-transform:uppercase; }
  .modal-close {
    position:absolute; top:1rem; right:1rem;
    background:rgba(255,255,255,0.1); border:none; color:var(--cream);
    width:30px; height:30px; border-radius:50%; cursor:pointer;
    font-size:16px; display:flex; align-items:center; justify-content:center;
    transition:background 0.15s;
  }
  .modal-close:hover { background:rgba(255,255,255,0.2); }

  .modal-body { padding:1.5rem; }

  .recipe-section { margin-bottom:1.5rem; }
  .recipe-section h3 {
    font-size:10px; letter-spacing:0.12em; text-transform:uppercase;
    color:var(--muted); margin-bottom:0.75rem;
    display:flex; align-items:center; gap:8px;
  }
  .recipe-section h3::after { content:''; flex:1; height:1px; background:var(--border); }

  .ingredients { list-style:none; display:flex; flex-direction:column; gap:6px; }
  .ingredients li {
    display:flex; justify-content:space-between; align-items:baseline;
    font-size:14px; padding-bottom:6px; border-bottom:1px solid var(--border);
  }
  .ingredients li:last-child { border-bottom:none; }
  .ing-name { color:var(--ink); }
  .ing-qty { color:var(--muted); font-size:13px; white-space:nowrap; margin-left:1rem; }

  .steps { list-style:none; display:flex; flex-direction:column; gap:10px; }
  .steps li { display:flex; gap:10px; font-size:14px; line-height:1.6; }
  .step-num {
    min-width:22px; height:22px; border-radius:50%;
    background:var(--ink); color:var(--cream);
    font-size:11px; font-weight:500;
    display:flex; align-items:center; justify-content:center;
    margin-top:2px; flex-shrink:0;
  }

  .servings-row {
    display:flex; align-items:center; gap:10px;
    margin-bottom:1.25rem; font-size:13px; color:var(--muted);
  }
  .servings-row button {
    width:28px; height:28px; border-radius:50%; border:1px solid var(--border);
    background:white; cursor:pointer; font-size:16px;
    display:flex; align-items:center; justify-content:center;
    transition:all 0.15s; color:var(--ink);
  }
  .servings-row button:hover { background:var(--ink); color:var(--cream); border-color:var(--ink); }
  .servings-count { font-size:15px; font-weight:500; color:var(--ink); min-width:20px; text-align:center; }

  footer { text-align:center; padding:2rem; font-size:12px; color:var(--muted); border-top:1px solid var(--border); letter-spacing:0.04em; }

  @media (max-width:500px) {
    .meal-grid { grid-template-columns:1fr; }
    header { padding:2rem 1.25rem 1.5rem; }
    .modal-body { padding:1.25rem; }
  }
</style>
</head>
<body>

<header>
  <div class="header-inner">
    <p>Gemensam matplanering</p>
    <h1>Veckans mat<br>— 5 veckor</h1>
    <div class="legend">
      <div class="legend-item"><span class="legend-dot" style="background:#2D6A4F"></span> Stor sats / matlådor</div>
      <div class="legend-item"><span class="legend-dot" style="background:#4C3A8B"></span> Nytt i planen</div>
      <div class="legend-item"><span class="legend-dot" style="background:rgba(247,244,239,0.3)"></span> Klicka på rätt för recept</div>
    </div>
  </div>
</header>

<main>
  <nav class="week-nav" id="nav"></nav>
  <div id="content"></div>
</main>

<div class="modal-overlay" id="overlay" role="dialog" aria-modal="true">
  <div class="modal" id="modal">
    <div class="modal-header">
      <button class="modal-close" id="modal-close" aria-label="Stäng">✕</button>
      <span class="m-icon" id="m-icon"></span>
      <h2 id="m-title"></h2>
      <p id="m-meta"></p>
    </div>
    <div class="modal-body">
      <div class="servings-row">
        <button id="srv-down">−</button>
        <span class="servings-count" id="srv-count">4</span>
        <span>portioner</span>
        <button id="srv-up">+</button>
      </div>
      <div class="recipe-section">
        <h3>Ingredienser</h3>
        <ul class="ingredients" id="m-ingredients"></ul>
      </div>
      <div class="recipe-section">
        <h3>Tillagning</h3>
        <ol class="steps" id="m-steps"></ol>
      </div>
    </div>
  </div>
</div>

<footer>Gjord med ❤ för er båda</footer>

